# intervals.icu APIプロキシ設定
# ~/icu-proxy.env としてコピーして値を入れる（公開ディレクトリ ~/www の外に置くこと）
# パーミッションは 600 推奨: chmod 600 ~/icu-proxy.env

# intervals.icu > Settings > Developer Settings で発行した API キー
ICU_API_KEY=your_intervals_icu_api_key
# アスリートID（例: i12345）。設定画面の Developer Settings に表示される
ICU_ATHLETE_ID=i12345
# クライアントが Authorization: Bearer で送る固定トークン（openssl rand -hex 32 などで生成）
PROXY_TOKEN=change_me

# 任意: ブラウザから直接呼ぶ場合のみ、許可するオリジンをカンマ区切りで指定
CORS_ALLOWED_ORIGINS=
# 任意: days の基準日（今日）を決めるタイムゾーン（既定: Asia/Tokyo）
ICU_TIMEZONE=Asia/Tokyo
